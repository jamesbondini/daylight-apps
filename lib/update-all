#!/bin/bash
# Update everything: Daylight Apps itself, the system packages (one password
# prompt), Flatpak apps, then each installed app by running its install
# script again, which by then usually has nothing left that needs root.
source "$(dirname "$(readlink -f "$0")")/common.sh"

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# Everything runs from main: pulling can rewrite this file while bash is
# still reading it
main() {
  local failed=() reopen= extensions=

  step "Updating Daylight Apps"
  if ! git -C "$ROOT" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    info "Skipped: $ROOT is not a git clone that follows a branch."
  elif [ -n "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]; then
    info "Skipped: files in $ROOT have been changed, so pulling could lose them."
  else
    local before
    before=$(git -C "$ROOT" rev-parse HEAD)
    # There is no terminal to ask for a password or key passphrase in, so
    # fail instead of waiting for one
    if GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes" \
        git -C "$ROOT" pull --ff-only; then
      if [ "$(git -C "$ROOT" rev-parse HEAD)" != "$before" ]; then
        "$ROOT/install.sh" || failed+=("Daylight Apps")
        git -C "$ROOT" diff --quiet "$before" HEAD -- daylight-apps.py || reopen=1
      fi
    else
      failed+=("Daylight Apps")
    fi
  fi

  # apk can fail over one broken package and still upgrade the rest, so
  # carry on to the Flatpaks and report it at the end
  local root='apk update
status=0
apk upgrade || status=1'
  if cmd_present flatpak && [ -n "$(flatpak list --system --app --columns=application 2>/dev/null)" ]; then
    root+='
echo; echo "==> Updating Flatpak apps installed for all users"
flatpak update --system -y --noninteractive || status=1'
  fi
  root+='
exit $status'
  step "Updating system packages (asks for your password)"
  as_root "$root" || failed+=("System packages")

  if cmd_present flatpak; then
    step "Updating Flatpak apps"
    flatpak update --user -y --noninteractive || failed+=("Flatpak apps")
  fi

  local dir dirs=()
  while IFS= read -r dir; do
    app_installed "$dir" && dirs+=("$dir")
  done < <(app_dirs)
  app_install_each Updating "${dirs[@]}"

  step "Done"
  [ -n "$extensions" ] && info "Log out and back in to load the updated extensions."
  [ -n "$reopen" ] && info "Close and reopen Daylight Apps to use its new version."
  if [ ${#failed[@]} -gt 0 ]; then
    fail "Could not update: $(join_names "${failed[@]}"). See above for why."
  fi
  info "Everything is up to date."
}

main
