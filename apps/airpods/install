#!/bin/bash
# Install and enable the bundled AirPods GNOME Shell extension. It talks to
# the AirPods itself through BlueZ, so there is nothing else to build or run.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

UUID=airpods@finni
SRC="$(dirname "$(readlink -f "$0")")/../../extensions/$UUID"
DEST="$HOME/.local/share/gnome-shell/extensions/$UUID"

# Earlier versions ran the librepods daemon, which would fight the extension
# over the AirPods' control channel
OLD="$HOME/.local/share/daylight-apps/airpods"
if [ -e "$HOME/.local/share/systemd/user/librepods.service" ] || [ -d "$OLD" ]; then
  step "Removing the librepods daemon from an earlier version"
  systemctl --user disable --now --quiet librepods.service 2>/dev/null || true
  if [ -f "$OLD/build/install_manifest.txt" ]; then
    # BusyBox xargs has no -d
    tr '\n' '\0' < "$OLD/build/install_manifest.txt" | xargs -0 -r rm -f
  fi
  rm -f "$HOME/.local/bin/librepods" "$HOME/.local/bin/librepods-ctl" \
    "$HOME/.local/share/systemd/user/librepods.service"
  systemctl --user daemon-reload
  rm -rf "$OLD"
fi
if apk_present .daylight-airpods; then
  step "Removing its build tools and Qt (asks for your password)"
  as_root "$(apk_del_cmd .daylight-airpods)"
fi

step "Copying extension to $DEST"
rm -rf "$DEST"
mkdir -p "$DEST"
cp -r "$SRC"/. "$DEST"/
glib-compile-schemas "$DEST/schemas"

step "Enabling extension"
gnome_ext_set_enabled "$UUID" true

step "Done"
info "Pair your AirPods in Bluetooth settings (“Pair AirPods” below) if you"
info "have not already. They then show up in Quick Settings."
if ! gnome-extensions info "$UUID" 2>/dev/null | grep -q "State: ACTIVE"; then
  info "Log out and back in to activate the extension."
fi
