#!/bin/bash
# Stop the daemon and turn the extension off, keeping both installed.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

step "Disabling extension"
gnome_ext_set_enabled airpods@finni false
step "Stopping the daemon"
systemctl --user disable --now --quiet librepods.service
info "Off. The AirPods still work as ordinary Bluetooth headphones."
