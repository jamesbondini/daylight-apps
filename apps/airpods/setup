#!/bin/bash
# Open Bluetooth settings to pair the AirPods.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

setsid gnome-control-center bluetooth >/dev/null 2>&1 &
info "Opened Bluetooth settings. Put the AirPods in their case, open the lid and"
info "hold the button on the back until the light flashes white, then pick them."
