#!/bin/bash
# Download a speech model: extra-add ID (from the models file)
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

HERE="$(dirname "$(readlink -f "$0")")"
path="$("$HERE/dictate" --path "${1:-}" 2>/dev/null)" || fail "Unknown model: ${1:-}"
title=$("$HERE/dictate" --title "$1")
step "Downloading $title"
"$HERE/dictate" --download "$1" || fail "Download failed"
step "Done"
# Use it straight away unless a downloaded model is already in use
engine=$(voice_engine)
if [ -z "$engine" ] || [ "$engine" = "$1" ] || ! [ -s "$("$HERE/dictate" --path "$engine")" ]; then
  if voice_set_engine "$1"; then
    info "Voice typing now uses $title."
  else
    info "Update Tablet Keyboard, then pick $title under Voice typing"
    info "in the keyboard settings (hold the hide key, then Settings)."
  fi
else
  info "To use it, pick $title under Voice typing in the keyboard settings"
  info "(hold the hide key, then Settings)."
fi
