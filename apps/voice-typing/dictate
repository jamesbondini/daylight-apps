#!/bin/bash
# Voice typing helper used by Tablet Keyboard's microphone key.
#
#   dictate [OPTION...] MODEL [WORD...]
#                               Record from the default microphone until a
#                               line or end of input arrives on stdin, then
#                               print the transcription. SIGTERM cancels.
#                               MODEL is an ID from the models file next to
#                               this script. Each WORD is a dictionary entry,
#                               "Word" or "Word = misheard, other misheard":
#                               Whisper is prompted with the words, and with
#                               both engines any match is fixed to the word's
#                               spelling. Options:
#     --language CODE           Language for a multilingual Whisper model,
#                               instead of detecting it.
#     --battery-saver           Run on the power-efficient CPU cores only:
#                               about twice as slow.
#   dictate --download MODEL    Download the model and check its checksum.
#   dictate --path MODEL        Print where the model goes.
#   dictate --title MODEL       Print the model's name.
#   dictate --size MODEL        Print the model's download size, like 148 MB.
#   dictate --resolve [MODEL]   Print the model voice typing uses: MODEL if
#                               it's known, else the first downloaded one;
#                               exits 1 when there is none.
set -u

MODELS="${XDG_DATA_HOME:-$HOME/.local/share}/dinstaller/voice-typing"
REGISTRY="$(dirname "$(readlink -f "$0")")/models"

# Sets ENGINE, LANGUAGE, BYTES, SHA256, TITLE and URL for a model ID from
# the registry
model_load() {
  local id engine language bytes sha256 title description url
  while IFS='|' read -r id engine language bytes sha256 title description url; do
    case "$id" in ''|'#'*) continue ;; esac
    if [ "$id" = "$1" ]; then
      ENGINE=$engine LANGUAGE=$language BYTES=$bytes SHA256=$sha256 TITLE=$title URL=$url
      return 0
    fi
  done <"$REGISTRY"
  echo "unknown model: $1" >&2
  return 1
}
model_path() {
  model_load "$1" || return 1
  echo "$MODELS/${URL##*/}"
}

case "${1:-}" in
  --path)
    model_path "${2:-}" || exit 2
    exit 0 ;;
  --title)
    model_load "${2:-}" || exit 2
    echo "$TITLE"
    exit 0 ;;
  --size)
    model_load "${2:-}" || exit 2
    echo "$(( (BYTES + 500000) / 1000000 )) MB"
    exit 0 ;;
esac

if [ "${1:-}" = --resolve ]; then
  if [ -n "${2:-}" ] && model_load "$2" 2>/dev/null; then
    echo "$2"
    exit 0
  fi
  while IFS='|' read -r id _ _ _ _ _ _ url; do
    case "$id" in ''|'#'*) continue ;; esac
    [ -s "$MODELS/${url##*/}" ] && { echo "$id"; exit 0; }
  done <"$REGISTRY"
  exit 1
fi

if [ "${1:-}" = --download ]; then
  model_load "${2:-}" || exit 2
  path="$MODELS/${URL##*/}"
  [ -s "$path" ] && exit 0
  mkdir -p "$MODELS"
  # The keyboard and the app can both start a download; two curls resuming
  # into the same .part would corrupt it, so the second waits for the first
  exec 9>"$path.lock"
  flock 9
  [ -s "$path" ] && exit 0
  # -C - resumes an interrupted download. A .part that is already complete
  # (stopped while being checked) skips curl: resuming past the end of the
  # file is an HTTP error, so it would fail every time
  if [ "$(stat -c %s "$path.part" 2>/dev/null)" != "$BYTES" ]; then
    curl -fL -C - --progress-bar -o "$path.part" "$URL" || exit 1
  fi
  echo "Checking the download"
  if [ "$(sha256sum "$path.part" | cut -d' ' -f1)" != "$SHA256" ]; then
    # Resuming a damaged file would only keep it damaged
    rm -f "$path.part"
    echo "The download was damaged; try again." >&2
    exit 1
  fi
  mv "$path.part" "$path"
  exit 0
fi

language= saver=
while [ $# -gt 0 ]; do
  case "$1" in
    --language) language=${2:-}; shift 2 || shift ;;
    --battery-saver) saver=1; shift ;;
    *) break ;;
  esac
done
case "$language" in
  ''|[a-z][a-z]|[a-z][a-z][a-z]) ;;
  *) echo "bad language: $language" >&2; exit 2 ;;
esac
model_load "${1:-}" || exit 2
MODEL="$MODELS/${URL##*/}"
shift
WORDS=("$@")
[ -s "$MODEL" ] || { echo "model missing: $MODEL" >&2; exit 3; }
# Models made for one language keep it
[ "$LANGUAGE" = auto ] && LANGUAGE=${language:-auto}

# On big.LITTLE CPUs (the DC-1 has 2 fast and 6 efficient cores) the
# scheduler already runs the engine on the fast cores, and more threads than
# fast cores only slows it down. Battery saver keeps it to the efficient ones.
fast= slow= max=0
for cap in /sys/devices/system/cpu/cpu[0-9]*/cpu_capacity; do
  [ -r "$cap" ] || continue
  c=$(cat "$cap"); [ "$c" -gt "$max" ] && max=$c
done
for cap in /sys/devices/system/cpu/cpu[0-9]*/cpu_capacity; do
  [ -r "$cap" ] || continue
  cpu=${cap%/cpu_capacity}; cpu=${cpu##*/cpu}
  if [ "$(cat "$cap")" -eq "$max" ]; then fast+="$cpu,"; else slow+="$cpu,"; fi
done
pin=()
if [ -z "$fast" ]; then
  threads=4
elif [ -n "$saver" ] && [ -n "$slow" ] && command -v taskset >/dev/null; then
  pin=(taskset -c "${slow%,}")
  threads=$(( $(echo "$slow" | tr -cd , | wc -c) ))
  [ "$threads" -gt 4 ] && threads=4
else
  threads=$(( $(echo "$fast" | tr -cd , | wc -c) ))
  [ "$threads" -lt 2 ] && threads=2
  [ "$threads" -gt 4 ] && threads=4
fi

# Tablet Keyboard reads the recording's loudness from here, by our pid
TMP="${XDG_RUNTIME_DIR:-/tmp}/dictate-$$"
rm -rf "$TMP"
mkdir -m 700 "$TMP" || exit 1
WAV="$TMP/speech.wav"
rec= job=

# Never "kill 0": that would signal the caller's whole process group
trap 'kill $rec $job 2>/dev/null; exit 143' TERM INT
trap 'rm -rf "$TMP"' EXIT

pw-record --rate 16000 --channels 1 --format s16 "$WAV" &
rec=$!

# Background jobs, so the TERM trap runs straight away
head -n 1 <&0 >/dev/null &
job=$!
wait "$job"

kill -INT "$rec" 2>/dev/null
wait "$rec"
rec=

# A simple command, so the job is the engine itself and the TERM trap kills
# it; a backgrounded case would be a subshell that leaves the engine running
case "$ENGINE" in
  whisper)  cmd=("${pin[@]}" whisper-cli -m "$MODEL" -f "$WAV" -l "${LANGUAGE:-auto}" -t "$threads" -nt -np) ;;
  parakeet) cmd=("${pin[@]}" parakeet-cli -m "$MODEL" -f "$WAV" -t "$threads" -np) ;;
  *) echo "unknown engine: $ENGINE" >&2; exit 2 ;;
esac
# Whisper continues from the prompt as if it were earlier speech, so a list
# of the words makes it spell them that way
if [ "$ENGINE" = whisper ] && [ ${#WORDS[@]} -gt 0 ]; then
  prompt=$(printf '%s\n' "${WORDS[@]}" | sed -E 's/=.*//; s/^ +| +$//g; /^$/d' | paste -sd ',' | sed 's/,/, /g')
  [ -n "$prompt" ] && cmd+=(--prompt "$prompt.")
fi
"${cmd[@]}" 2>/dev/null >"$TMP/text" &
job=$!
wait "$job" || exit 1

# Whisper marks non-speech with tags like [BLANK_AUDIO] or (wind blowing)
tags='s/\[[^]]*\]//g; s/\([^)]*\)//g'
[ "$ENGINE" = whisper ] || tags=
# One line, with dictionary words spelled the way they were added
spell() {
  if [ ${#WORDS[@]} -eq 0 ]; then cat; return; fi
  python3 -I -c '
import re, sys
text = sys.stdin.read()
for entry in sys.argv[1:]:
    word, _, heard = entry.partition("=")
    word = word.strip()
    if not word:
        continue
    forms = [word] + [h.strip() for h in heard.split(",")]
    forms = sorted({f for f in forms if f}, key=len, reverse=True)
    # Words of a phrase may come out joined by a hyphen too
    alts = "|".join(r"[\s-]+".join(map(re.escape, f.split())) for f in forms)
    text = re.sub(rf"(?<!\w)(?:{alts})(?!\w)", lambda m: word, text, flags=re.I)
print(text, end="")
' "${WORDS[@]}"
}
sed -E "$tags" "$TMP/text" | tr -s ' \n' ' ' | sed -E 's/^ +| +$//g' | spell
