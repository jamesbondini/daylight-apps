#!/bin/bash
# Voice typing helper used by Tablet Keyboard's microphone key.
#
#   dictate [ENGINE [WORD...]]   Record from the default microphone until a
#                                line or end of input arrives on stdin, then
#                                print the transcription. SIGTERM cancels.
#                                ENGINE is whisper or parakeet. Each WORD is a
#                                dictionary entry, "Word" or "Word = misheard,
#                                other misheard": Whisper is prompted with the
#                                words, and with both engines any match is
#                                fixed to the word's spelling.
#   dictate --download ENGINE    Download the engine's model.
#   dictate --path ENGINE        Print where the engine's model goes.
set -u

MODELS="${XDG_DATA_HOME:-$HOME/.local/share}/daylight-apps/voice-typing"

# Model files; keep in sync with MODELS in tablet-keyboard@finni/voice.js
model_file() {
  case "$1" in
    whisper)  echo ggml-base.en.bin ;;
    parakeet) echo ggml-parakeet-tdt-0.6b-v3-q4_k.bin ;;
    *) echo "unknown engine: $1" >&2; return 1 ;;
  esac
}
model_url() {
  case "$1" in
    whisper)  echo "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$(model_file "$1")" ;;
    parakeet) echo "https://huggingface.co/ggml-org/parakeet-GGUF/resolve/main/$(model_file "$1")" ;;
  esac
}

if [ "${1:-}" = --path ]; then
  file="$(model_file "${2-whisper}")" || exit 2
  echo "$MODELS/$file"
  exit 0
fi

if [ "${1:-}" = --download ]; then
  engine="${2-whisper}"
  file="$(model_file "$engine")" || exit 2
  [ -s "$MODELS/$file" ] && exit 0
  mkdir -p "$MODELS"
  # The keyboard and the app can both start a download; two curls resuming
  # into the same .part would corrupt it, so the second waits for the first
  exec 9>"$MODELS/$file.lock"
  flock 9
  [ -s "$MODELS/$file" ] && exit 0
  # -C - resumes an interrupted download
  curl -fL -C - --progress-bar -o "$MODELS/$file.part" "$(model_url "$engine")" || exit 1
  mv "$MODELS/$file.part" "$MODELS/$file"
  exit 0
fi

ENGINE="${1:-whisper}"
shift $(( $# > 0 ))
WORDS=("$@")
MODEL="$MODELS/$(model_file "$ENGINE")" || exit 2
[ -s "$MODEL" ] || { echo "model missing: $MODEL" >&2; exit 3; }

# Tablet Keyboard reads the recording's loudness from here, by our pid
TMP="${XDG_RUNTIME_DIR:-/tmp}/dictate-$$"
rm -rf "$TMP"
mkdir -m 700 "$TMP" || exit 1
WAV="$TMP/speech.wav"
rec= job=

# Never "kill 0": that would signal the caller's whole process group
trap 'kill $rec $job 2>/dev/null; exit 143' TERM INT
trap 'rm -rf "$TMP"' EXIT

pw-record --rate 16000 --channels 1 --format s16 "$WAV" &
rec=$!

# Background jobs, so the TERM trap runs straight away
head -n 1 <&0 >/dev/null &
job=$!
wait "$job"

kill -INT "$rec" 2>/dev/null
wait "$rec"
rec=

# A simple command, so the job is the engine itself and the TERM trap kills
# it; a backgrounded case would be a subshell that leaves the engine running
case "$ENGINE" in
  whisper)  cmd=(whisper-cli -m "$MODEL" -f "$WAV" -l en -t 4 -nt -np) ;;
  parakeet) cmd=(parakeet-cli -m "$MODEL" -f "$WAV" -t 4 -np) ;;
esac
# Whisper continues from the prompt as if it were earlier speech, so a list
# of the words makes it spell them that way
if [ "$ENGINE" = whisper ] && [ ${#WORDS[@]} -gt 0 ]; then
  prompt=$(printf '%s\n' "${WORDS[@]}" | sed -E 's/=.*//; s/^ +| +$//g; /^$/d' | paste -sd ',' | sed 's/,/, /g')
  [ -n "$prompt" ] && cmd+=(--prompt "$prompt.")
fi
"${cmd[@]}" 2>/dev/null >"$TMP/text" &
job=$!
wait "$job" || exit 1

# Whisper marks non-speech with tags like [BLANK_AUDIO] or (wind blowing)
tags='s/\[[^]]*\]//g; s/\([^)]*\)//g'
[ "$ENGINE" = whisper ] || tags=
# One line, with dictionary words spelled the way they were added
spell() {
  if [ ${#WORDS[@]} -eq 0 ]; then cat; return; fi
  python3 -I -c '
import re, sys
text = sys.stdin.read()
for entry in sys.argv[1:]:
    word, _, heard = entry.partition("=")
    word = word.strip()
    if not word:
        continue
    forms = [word] + [h.strip() for h in heard.split(",")]
    forms = sorted({f for f in forms if f}, key=len, reverse=True)
    # Words of a phrase may come out joined by a hyphen too
    alts = "|".join(r"[\s-]+".join(map(re.escape, f.split())) for f in forms)
    text = re.sub(rf"(?<!\w)(?:{alts})(?!\w)", lambda m: word, text, flags=re.I)
print(text, end="")
' "${WORDS[@]}"
}
sed -E "$tags" "$TMP/text" | tr -s ' \n' ' ' | sed -E 's/^ +| +$//g' | spell
