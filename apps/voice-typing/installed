#!/bin/bash
# Exit 0 if installed; print a one-line status.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

DEST="${XDG_DATA_HOME:-$HOME/.local/share}/daylight-apps/voice-typing"
[ -x "$DEST/dictate" ] || exit 1
engine=$(voice_engine)
if ! cmd_present whisper-cli || ! [ -f "$DEST/models" ]; then
  echo "Out of date, press Update"
elif ! gnome_ext_enabled tablet-keyboard@jamesbondini; then
  echo "Install Tablet Keyboard for the microphone key"
elif [ -z "$engine" ]; then
  echo "Download a speech model below to start"
elif ! [ -s "$("$DEST/dictate" --path "$engine")" ]; then
  echo "$("$DEST/dictate" --title "$engine") is picked but not downloaded"
else
  echo "Ready · using $("$DEST/dictate" --title "$engine")"
fi
