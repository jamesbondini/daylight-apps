#!/bin/bash
# Install whisper.cpp (which also provides parakeet-cli) and set up the
# dictate helper Tablet Keyboard's microphone key uses. No speech model is
# downloaded here: the user picks one from the app's Speech Models list (the
# models file), or in the keyboard settings.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

HERE="$(dirname "$(readlink -f "$0")")"
DEST="${XDG_DATA_HOME:-$HOME/.local/share}/daylight-apps/voice-typing"

if ! apk_present whisper.cpp; then
  step "Installing whisper.cpp (asks for your password)"
  as_root "$(apk_add_cmd whisper.cpp)"
fi
cmd_present pw-record || fail "pw-record is missing (part of pipewire-tools)"

# The helper is copied last: the keyboard shows its microphone key once it
# exists, and reads the model list next to it
step "Installing the dictate helper"
mkdir -p "$DEST"
install -m 644 "$HERE/models" "$DEST/models"
install -m 755 "$HERE/dictate" "$DEST/dictate"

step "Done"
info "Tablet Keyboard now has a microphone key next to the emoji key:"
info "hold it while you speak, or tap to start and tap again to stop."
if [ -z "$(voice_engine)" ]; then
  info "Now pick a speech model under Speech Models below to download it:"
  info "Whisper base.en for English, or Parakeet for other European languages."
fi
