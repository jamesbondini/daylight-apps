#!/bin/bash
# Install whisper.cpp (which also provides parakeet-cli), download the Whisper
# base.en model and set up the dictate helper Tablet Keyboard's microphone
# key uses. The Parakeet model downloads from the app's Speech Models list,
# or when it is first picked in the keyboard settings.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

HERE="$(dirname "$(readlink -f "$0")")"
DEST="${XDG_DATA_HOME:-$HOME/.local/share}/daylight-apps/voice-typing"

if ! apk_present whisper.cpp; then
  step "Installing whisper.cpp (asks for your password)"
  as_root "$(apk_add_cmd whisper.cpp)"
fi
cmd_present pw-record || fail "pw-record is missing (part of pipewire-tools)"

step "Downloading the Whisper base.en model (142 MB)"
"$HERE/dictate" --download whisper || fail "Download failed"

# Copied last: the keyboard shows its microphone key once this exists
step "Installing the dictate helper"
mkdir -p "$DEST"
install -m 755 "$HERE/dictate" "$DEST/dictate"

step "Done"
info "Tablet Keyboard now has a microphone key next to the emoji key:"
info "hold it while you speak, or tap to start and tap again to stop."
info "For other languages, download Parakeet under Speech Models below and"
info "pick it under Voice typing in the keyboard settings (hold the hide key)."
