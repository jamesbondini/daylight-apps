#!/bin/bash
# List the speech models as ID|Title|Subtitle|yes-or-no (downloaded).
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

HERE="$(dirname "$(readlink -f "$0")")"
engine=$(voice_engine)
model() {
  local id=$1 title=$2 subtitle=$3 have=no
  [ "$id" = "$engine" ] && subtitle+=" · in use"
  [ -s "$("$HERE/dictate" --path "$id")" ] && have=yes
  echo "$id|$title|$subtitle|$have"
}
model whisper "Whisper base.en" "English · 142 MB"
model parakeet "Parakeet TDT 0.6B v3" "25 European languages, detected automatically · 416 MB"
