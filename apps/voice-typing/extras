#!/bin/bash
# List the speech models in the models file as ID|Title|Subtitle|yes-or-no
# (downloaded), after a line saying how much space the downloaded ones use.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

HERE="$(dirname "$(readlink -f "$0")")"
engine=$(voice_engine)
used=0
rows=()
# Where dictate --path puts each model, and the size dictate --size prints
MODELS="${XDG_DATA_HOME:-$HOME/.local/share}/dinstaller/voice-typing"
while IFS='|' read -r id _ _ bytes _ title description url; do
  case "$id" in ''|'#'*) continue ;; esac
  have=no
  if [ -s "$MODELS/${url##*/}" ]; then
    have=yes
    used=$(( used + bytes ))
  fi
  subtitle="$description · $(( (bytes + 500000) / 1000000 )) MB"
  [ "$id" = "$engine" ] && subtitle+=" · in use"
  rows+=("$id|$title|$subtitle|$have")
done <"$HERE/models"
if [ "$used" -gt 0 ]; then
  echo "Downloaded models use $(( (used + 500000) / 1000000 )) MB. Remove the ones you don't need to free the space."
else
  echo "Download a model to start voice typing. Each one can be removed again here."
fi
printf '%s\n' "${rows[@]}"
