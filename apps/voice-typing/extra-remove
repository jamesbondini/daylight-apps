#!/bin/bash
# Delete a speech model: extra-remove ID (from the models file)
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

HERE="$(dirname "$(readlink -f "$0")")"
path="$("$HERE/dictate" --path "${1:-}" 2>/dev/null)" || fail "Unknown model: ${1:-}"
title=$("$HERE/dictate" --title "$1")
in_use=no
[ "$1" = "$(voice_engine)" ] && in_use=yes
step "Removing $title"
rm -f "$path" "$path.part" "$path.lock"
step "Done"
if [ "$in_use" = yes ]; then
  # Fall back to another downloaded model, rather than downloading this
  # one again on the next tap of the microphone key
  voice_set_engine || true
  engine=$(voice_engine)
  if [ -n "$engine" ] && [ -s "$("$HERE/dictate" --path "$engine")" ]; then
    info "Voice typing now uses $("$HERE/dictate" --title "$engine")."
  else
    info "Download another model to keep using voice typing."
  fi
fi
