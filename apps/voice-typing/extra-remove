#!/bin/bash
# Delete a speech model: extra-remove whisper|parakeet
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

HERE="$(dirname "$(readlink -f "$0")")"
path="$("$HERE/dictate" --path "${1:-}" 2>/dev/null)" || fail "Unknown model: ${1:-}"
step "Removing the ${1^} model"
rm -f "$path" "$path.part"
step "Done"
if [ "$1" = "$(voice_engine)" ]; then
  info "The keyboard uses ${1^}: it downloads the model again on your next"
  info "tap of the microphone key, unless you pick the other engine."
fi
