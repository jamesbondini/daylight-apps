#!/bin/bash
# Try voice typing in a terminal, with the engine picked in the keyboard settings.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"
require_terminal "$0"

DICTATE="$HOME/.local/share/daylight-apps/voice-typing/dictate"
engine=$(voice_engine)
"$DICTATE" --download "$engine" || fail "Download failed"
echo "Engine: ${engine^}. Say something, then press Enter."
text=$("$DICTATE" "$engine")
echo
echo "Heard: ${text:-(nothing)}"
