#!/bin/bash
# Turn the extension on.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

UUID=hardware-buttons@finni
step "Enabling extension"
"$(dirname "$(readlink -f "$0")")/shell-keys" take
gnome_ext_set_enabled "$UUID" true
if gnome-extensions info "$UUID" 2>/dev/null | grep -q "State: ACTIVE"; then
  info "On. The buttons run their actions."
else
  info "Log out and back in to activate it."
fi
