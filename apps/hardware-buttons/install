#!/bin/bash
# Install and enable the bundled hardware-buttons GNOME Shell extension.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

UUID=hardware-buttons@jamesbondini
SRC="$(dirname "$(readlink -f "$0")")/../../extensions/$UUID"
DEST="$HOME/.local/share/gnome-shell/extensions/$UUID"

# Update leaves an extension the user turned off switched off
WAS_OFF=
[ -f "$DEST/extension.js" ] && ! gnome_ext_enabled "$UUID" && WAS_OFF=1

step "Copying extension to $DEST"
rm -rf "$DEST"
mkdir -p "$DEST"
cp -r "$SRC"/. "$DEST"/
glib-compile-schemas "$DEST/schemas"

if [ -n "$WAS_OFF" ]; then
  step "Done"
  info "Updated. It is still turned off; use the switch above to turn it on."
  exit 0
fi

step "Taking the buttons over from GNOME Shell's own shortcuts"
"$(dirname "$(readlink -f "$0")")/shell-keys" take

step "Enabling extension"
gnome_ext_set_enabled "$UUID" true

if gnome-extensions info "$UUID" 2>/dev/null | grep -q "State: ACTIVE"; then
  step "Done"
  info "Active. Pick what each button does below."
else
  step "Done"
  info "Log out and back in to activate it (Wayland only loads new extensions at login)."
fi
