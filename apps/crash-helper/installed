#!/bin/bash
# Exit 0 if installed; print a one-line status.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

[ -f "$HOME/.local/share/systemd/user/crash-helper.service" ] || exit 1
if systemctl --user is-active --quiet crash-helper.service; then
  echo "Watching for crashes"
else
  echo "Off"
fi
