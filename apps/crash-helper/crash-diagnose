#!/bin/bash
# Open Claude Code in a terminal to diagnose a crash. Run from a Crash Helper
# notification, or by hand with a PID from `coredumpctl list`. The method lives
# in the diagnose-crash skill; this only gathers the facts and points at it.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

pid=${1:-}
if [[ ! $pid =~ ^[0-9]+$ ]]; then
  echo "Usage: crash-diagnose <pid> [comm] [exe] [signal]   (see: coredumpctl list)" >&2
  exit 1
fi

# From the notification there is no terminal yet, so reopen this in one
if [ ! -t 0 ]; then
  in_terminal "$(printf '%q ' "$(readlink -f "$0")" "$@")"
  exit 0
fi

comm=${2:-unknown} exe=${3:-unknown} signal=${4:-unknown}
when=$(coredumpctl list "$pid" --no-pager --no-legend 2>/dev/null | tail -1 | awk '{print $1, $2, $3, $4}') || true

prompt=$(cat <<PROMPT
A program crashed on this Daylight DC-1 (postmarketOS, aarch64, musl) and I want to know why.

What systemd-coredump recorded:
  process:  $comm
  PID:      $pid
  binary:   $exe
  signal:   $signal
  time:     ${when:-unknown}

Use the diagnose-crash skill. If it is not loaded, read and follow
~/.claude/skills/diagnose-crash/SKILL.md.
PROMPT
)

cd "$HOME"
exec "$HOME/.local/bin/claude" "$prompt"
