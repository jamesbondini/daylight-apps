#!/bin/bash
# Exit 0 if installed; print a one-line status.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

status=$(flatpak_status com.brave.Browser) || exit 1
if [ -f /etc/brave/policies/managed/daylight-apps.json ]; then
  echo "$status · extras off"
else
  echo "$status · extras on"
fi
