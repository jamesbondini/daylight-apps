#!/bin/bash
# Remove Flatpak, but only once no Flatpak apps are left.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

if cmd_present flatpak; then
  apps=$(flatpak list --app --columns=name 2>/dev/null || true)
  if [ -n "$apps" ]; then
    echo "These apps still use Flatpak:"
    echo "$apps" | sed 's/^/    /'
    fail "Remove them first."
  fi
  step "Removing the Flathub remote"
  flatpak remote-delete --user --force flathub 2>/dev/null || true
fi

step "Removing Flatpak (asks for your password)"
as_root "$(apk_del_cmd flatpak)"
step "Done"
