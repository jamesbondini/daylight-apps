#!/bin/bash
# Exit 0 if installed; print a one-line status.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

cmd_present wl-copy && cmd_present wl-paste || exit 1
echo "v$(apk info -e wl-clipboard >/dev/null && apk list -I wl-clipboard 2>/dev/null | sed -n 's/^wl-clipboard-\([^ ]*\)-r[0-9]* .*/\1/p')"
