#!/bin/bash
# Install Tailscale from the Alpine repos and start the daemon.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

# Once set up there is nothing to do as root (Update All upgrades the
# package), so updating doesn't ask for the password again. Setting the
# operator only works for someone who is the operator already, so it doubles
# as the check that this step was done.
if apk_present tailscale tailscale-systemd && systemctl is-active --quiet tailscaled.service &&
    tailscale set --operator="$USER" >/dev/null 2>&1; then
  step "Done"
  if tailscale status >/dev/null 2>&1; then
    info "Tailscale is installed and running."
  else
    info "Next: press “Log In” to connect this device to your tailnet."
  fi
  exit 0
fi

step "Installing tailscale (asks for your password)"
as_root "
  $(apk_add_cmd tailscale tailscale-systemd)
  echo; echo '==> Starting tailscaled'
  systemctl enable --now tailscaled.service
  for i in \$(seq 20); do [ -S /run/tailscale/tailscaled.sock ] && break; sleep 0.5; done
  echo; echo '==> Allowing $USER to manage Tailscale'
  tailscale set --operator='$USER'
"

step "Done"
info "Next: press “Log In” to connect this device to your tailnet."
