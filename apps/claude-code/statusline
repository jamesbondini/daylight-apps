#!/bin/sh
# Claude Code status line: model name and context usage
input=$(cat)
if command -v jq >/dev/null 2>&1; then
  model=$(printf '%s' "$input" | jq -r '.model.display_name // empty')
  used=$(printf '%s' "$input" | jq -r '.context_window.used_percentage // empty')
elif command -v python3 >/dev/null 2>&1; then
  out=$(printf '%s' "$input" | python3 -I -c '
import sys, json
d = json.load(sys.stdin)
print((d.get("model") or {}).get("display_name") or "")
u = (d.get("context_window") or {}).get("used_percentage")
print("" if u is None else u)')
  model=$(printf '%s\n' "$out" | sed -n 1p)
  used=$(printf '%s\n' "$out" | sed -n 2p)
else
  model=$(printf '%s' "$input" | sed -n 's/.*"display_name"[ ]*:[ ]*"\([^"]*\)".*/\1/p' | head -n 1)
  used=$(printf '%s' "$input" | sed -n 's/.*"used_percentage"[ ]*:[ ]*\([0-9.]*\).*/\1/p' | head -n 1)
fi
[ -z "$model" ] && model="Claude"
if [ -n "$used" ]; then
  printf '%s | ctx: %.0f%% used' "$model" "$used"
else
  printf '%s | ctx: --' "$model"
fi
