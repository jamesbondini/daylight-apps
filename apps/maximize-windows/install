#!/bin/bash
# Install and enable the bundled maximize-new-windows GNOME Shell extension.
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

UUID=maximize-new-windows@finni
SRC="$(dirname "$(readlink -f "$0")")/../../extensions/$UUID"
DEST="$HOME/.local/share/gnome-shell/extensions/$UUID"

step "Copying extension to $DEST"
mkdir -p "$DEST"
cp "$SRC"/* "$DEST"/

step "Enabling extension"
gnome_ext_set_enabled "$UUID" true

if gnome-extensions info "$UUID" 2>/dev/null | grep -q "State: ACTIVE"; then
  step "Done"
  info "Active. New windows will open maximized."
else
  step "Done"
  info "Log out and back in to activate it (Wayland only loads new extensions at login)."
fi
