#!/bin/bash
# Install the 1Password desktop app from Flathub (per-user, no root needed).
source "$(dirname "$(readlink -f "$0")")/../../lib/common.sh"

APP=com.onepassword.OnePassword
step "Installing 1Password from Flathub (this is a large download)"
flatpak install --user -y --noninteractive flathub "$APP"

step "Done"
info "Press “Open” to sign in."
